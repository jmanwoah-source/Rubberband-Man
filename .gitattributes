* text=auto

# Enforce Unix LF line endings for Linux, GX10 ARM64, and Docker portability
*.sh text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.env.example text eol=lf

# Preserve binary assets and database files untouched
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.db binary
