[Unit]
Description=Rubberband Man - AI Options Divergence Terminal
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/RubberbandMan
ExecStart=%h/RubberbandMan/.venv/bin/python -m streamlit run rubberband.py --server.port 8501 --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=default.target
