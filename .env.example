# ==============================================================================
# Rubberband Man - Environment Configuration Example
# Copy this file to .env and insert your API credentials.
# On Linux: cp .env.example .env
# ==============================================================================

# 1. Financial Modeling Prep (FMP) Ultra API Key (Required for Fed/Macro/SEC 13F/Ratios)
# Get a key at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_api_key_here

# 1b. MarketData.app (MarketData.com) Institutional API Key (Primary Options Greeks/IV, Bulk Quotes & Extended-Hours Candles)
# Get a key at: https://www.marketdata.app/
MARKETDATA_API_KEY=your_marketdata_api_key_here

# 2. Google Gemini API Key (Required when using Cloud Gemini 2.5 Flash)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. LLM Compute Engine Backend Selection: 'gemini' (Default) or 'local'
LLM_BACKEND=gemini

# 4. Open-Source Local Model Configuration (For ASUS GTX 10 / Linux Supercomputer / Ollama / vLLM)
# Default Ollama endpoint: http://localhost:11434/v1
# Default vLLM endpoint:    http://localhost:8000/v1
# Default LM Studio:       http://localhost:1234/v1
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_API_KEY=ollama
