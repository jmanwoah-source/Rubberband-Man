# ==============================================================================
# Rubberband Man - Environment Configuration Example
# Copy this file to .env and populate your API credentials:
#   cp .env.example .env && chmod 600 .env
# Never commit .env to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server, Networking & Security
# ------------------------------------------------------------------------------
# FastAPI + React PWA listen port.
# Defaults to 8080 intentionally to avoid colliding with local vLLM servers on :8000.
PORT=8080

# Comma-separated list of allowed CORS origins for cross-origin frontends/proxies.
# Leave blank when serving the built React PWA from the same origin (FastAPI on :8080),
# or add e.g. http://gx10.tailnet.ts.net:8080,http://192.168.1.50:8080
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 2. Market & Options Data Providers
# ------------------------------------------------------------------------------
# Financial Modeling Prep (FMP) Ultra API Key (Macro, Fundamentals, Batch Quotes, SEC 13F)
# https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_api_key_here

# MarketData.app Institutional API Key (Primary OPRA Options Greeks/IV, NBBO Quotes & Candles)
# https://www.marketdata.app/
MARKETDATA_API_KEY=your_marketdata_api_key_here

# Optional MarketData.app base URL override (default: https://api.marketdata.app/v1)
MARKETDATA_BASE_URL=https://api.marketdata.app/v1

# ------------------------------------------------------------------------------
# 3. AI / LLM Compute Router (Cloud Gemini 2.5 + Local ASUS GX10)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for Cloud Gemini arbiter & automatic standby fallback)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini model identifier (falls back automatically if unavailable)
GEMINI_MODEL=gemini-2.5-flash

# Active LLM backend: 'gemini' (Default) or 'local' (ASUS GX10 Ollama / vLLM / SGLang)
LLM_BACKEND=gemini

# Local OpenAI-compatible inference server on ASUS GX10 ARM64 / Linux workstation:
#   Ollama default:    http://localhost:11434/v1
#   vLLM default:      http://localhost:8000/v1   (kept separate from Rubberband API on :8080)
#   LM Studio default: http://localhost:1234/v1
#   Inside Docker:     http://host.docker.internal:11434/v1
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_API_KEY=ollama

# ------------------------------------------------------------------------------
# 4. ASUS GX10 Autonomous Intel Bus Bridge (Optional)
# ------------------------------------------------------------------------------
# Override path for shared Qwen Wiki signals_bridge.json & intel_bus.db.
# Leave empty to auto-discover /shared/intel_bus, /mnt/gx10_shared/intel_bus, or ./intel_bus.
INTEL_BUS_DIR=
